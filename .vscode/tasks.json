{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-ui",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/PhotoLikerUI/PhotoLikerUI.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build-ui-release",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/PhotoLikerUI/PhotoLikerUI.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run-ui",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/PhotoLikerUI/PhotoLikerUI.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "package-installer",
      "command": "pwsh",
      "type": "process",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/installer/build-installer.ps1"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/PhotoLiker.Tests/PhotoLiker.Tests.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
