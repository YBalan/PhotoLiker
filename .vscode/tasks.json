{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-ui",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/PhotoLikerUI/PhotoLikerUI.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build-ui-release",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/PhotoLikerUI/PhotoLikerUI.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run-ui",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/PhotoLikerUI/PhotoLikerUI.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "package-installer",
      "command": "pwsh",
      "type": "process",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/installer/build-installer.ps1"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish-release-check",
      "detail": "Dry run: every check of a release, nothing tagged or pushed",
      "command": "pwsh",
      "type": "process",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/installer/publish-release.ps1",
        "-Version",
        "${input:releaseVersion}",
        "-DryRun"
      ],
      "problemMatcher": []
    },
    {
      "label": "publish-release",
      "detail": "Tag the current commit v<version> and push the tag: GitHub Actions (release.yml) builds and publishes the release",
      "command": "pwsh",
      "type": "process",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/installer/publish-release.ps1",
        "-Version",
        "${input:releaseVersion}",
        "-Watch"
      ],
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/PhotoLiker.Tests/PhotoLiker.Tests.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    }
  ],
  "inputs": [
    {
      "id": "releaseVersion",
      "type": "promptString",
      "description": "Version to release: major.minor.patch, e.g. 2.1.0 (it becomes the tag v<version>)"
    }
  ]
}
