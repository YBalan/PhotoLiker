<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vector files: the 3D and drawing formats that are not photos, read so that they can be looked at like photos. The first is STL (the mesh of a 3D model: a CAD program writes it,
    a slicer reads it), as a binary or a text file. What is read is a list of triangles, and what leaves is a picture of them: a software renderer (a z-buffer, flat shading with
    two lights, an orthographic camera that orbits the model) made for this program, so there is no graphics card, no WPF and no package to depend on.

    No user interface and nothing of Windows, so any front end can use it: PhotoLikerUI turns the pixels into a bitmap and takes the mouse. It does not depend on any other
    project of the solution.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PhotoLiker.VectorFiles</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PhotoLiker.VectorFiles.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PhotoLikerUI.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
