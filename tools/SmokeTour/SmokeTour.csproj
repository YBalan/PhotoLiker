<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Opens the real PhotoLiker window on a generated demo folder, drives it like a user would and checks what happens.
    Optionally takes the screenshots of the README. Not part of PhotoLiker.sln, nothing in CI builds it.
    See "Smoke tour" in the README.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SmokeTour</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PhotoLikerUI\PhotoLikerUI.csproj" />
    <ProjectReference Include="..\..\PhotoLiker.Core\PhotoLiker.Core.csproj" />
  </ItemGroup>

</Project>
