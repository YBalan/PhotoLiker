<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoLiker.Core\PhotoLiker.Core.csproj" />
  </ItemGroup>

  <!-- A net10.0 project can't reference the net10.0-windows app, so the WinForms-free sources under test are compiled in. -->
  <ItemGroup>
    <Compile Include="..\PhotoLikerUI\PhotoFile.cs" Link="PhotoLikerUI\PhotoFile.cs" />
    <Compile Include="..\PhotoLikerUI\LikedLibrary.cs" Link="PhotoLikerUI\LikedLibrary.cs" />
    <Compile Include="..\PhotoLikerUI\GroupLibrary.cs" Link="PhotoLikerUI\GroupLibrary.cs" />
    <Compile Include="..\PhotoLikerUI\StringListConverter.cs" Link="PhotoLikerUI\StringListConverter.cs" />
    <Compile Include="..\PhotoLikerUI\StoredPaths.cs" Link="PhotoLikerUI\StoredPaths.cs" />
  </ItemGroup>

</Project>