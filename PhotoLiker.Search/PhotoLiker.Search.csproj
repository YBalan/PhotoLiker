<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Photo search: CLIP embeddings for text search, face detection and recognition for people, kept in an SQLite index.
    Everything runs on this machine with ONNX Runtime. WPF is only used for its WIC image decoder.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PhotoLiker.Search</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoLiker.Core\PhotoLiker.Core.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PhotoLiker.Search.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
