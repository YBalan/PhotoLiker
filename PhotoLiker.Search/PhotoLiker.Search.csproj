<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Photo search: CLIP-like embeddings (CLIP, SigLIP 2, XLM-R) for text search, face detection and recognition for people, kept in an SQLite index.
    Everything runs on this machine with ONNX Runtime. WPF is only used for its WIC image decoder.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PhotoLiker.Search</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoLiker.Core\PhotoLiker.Core.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PhotoLiker.Search.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The video library works with the same vectors, resizing and models as the photos -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PhotoLiker.Video</_Parameter1>
    </AssemblyAttribute>
    <!-- ... and so do the effects (the colours of a photo are made on the picture resized the same way) -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PhotoLiker.Effects</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PhotoLiker.Video.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
