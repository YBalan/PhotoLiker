<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PhotoLiker.Core\PhotoLiker.Core.csproj" />
    <ProjectReference Include="..\PhotoLiker.GenerateVideo\PhotoLiker.GenerateVideo.csproj" />
    <ProjectReference Include="..\PhotoLiker.Search\PhotoLiker.Search.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="PhotoLiker.Core" />
    <Using Include="PhotoLiker.GenerateVideo" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>PhotoLiker.ico</ApplicationIcon>

    <!-- The compiler fills in the * on every build (days since 2000-01-01 and seconds since midnight / 2), so the
         version grows with each build. AppVersionInfo reads the build date back from it. -->
    <AssemblyVersion>2.0.*</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Deterministic>false</Deterministic>

    <!-- The release workflow (.github\workflows\release.yml) and installer\build-installer.ps1 -Version pass the version of the tag
         (-p:Version=2.1.0); it ends up in the informational version, which is how the program knows which release it is (AppVersionInfo, the
         "Check for updates" button of the About box). Any other build is 0.0.0-dev and is no release. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="PhotoLiker.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The user manual (docs\manual.en.html, docs\manual.ua.html, docs\manual.css) and the pictures of docs\images that it shows go into
       Manual\ next to the program, where the About box looks for them. Publishing copies them as well, so the zip and the installer
       (which packs the published folder) have them. In the repository the pages find the same pictures at images\. -->
  <ItemGroup>
    <Content Include="..\docs\manual.*" Link="Manual\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\docs\images\*.png" Link="Manual\images\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The language files (languages\photo-liker-en.txt, photo-liker-ua.txt ...) go into Languages\ next to the program, where the Language row of
       the settings looks for them (and in %LocalAppData%\PhotoLiker\Languages). Publishing copies them as well, so the zip and the installer have them.
       Any file photo-liker-<code>.txt added to the folder languages\ is a language of the program. -->
  <ItemGroup>
    <Content Include="..\languages\photo-liker-*.txt" Link="Languages\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ffmpeg.exe is GPL v3 software (the gyan.dev build): its licence and where to get its source go with it, into ffmpeg\ beside the program,
       and into the zip and the installer, which pack the published folder. The MIT licence of the program itself goes beside PhotoLikerUI.exe. -->
  <ItemGroup>
    <None Update="ffmpeg\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ffmpeg\FFMPEG-NOTICE.txt;ffmpeg\COPYING.GPLv3.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="..\LICENSE.txt" Link="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>